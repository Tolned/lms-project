# Django
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,web

# PostgreSQL (хост db — имя сервиса из docker-compose)
POSTGRES_DB=lms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/lms

# Redis (хост redis — имя сервиса из docker-compose)
REDIS_URL=redis://redis:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SUCCESS_URL=http://localhost:8000/lms/payment/success/
STRIPE_CANCEL_URL=http://localhost:8000/lms/payment/cancel/

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@lms-project.local